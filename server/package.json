{
  "name": "@dmm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "gen:model": "tsx src/scripts/gen-model-migration.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "db:setup": "tsx src/scripts/db-setup.ts",
    "db:reset": "tsx src/scripts/db-setup.ts --reset && tsx src/scripts/migrate.ts && tsx src/scripts/seed.ts",
    "test": "tsx --test src/test/*.test.ts",
    "test:isolation": "tsx --test src/test/isolation.test.ts",
    "test:lock": "tsx --test src/test/lock.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
