{
  "name": "dmm",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Maturity Model — Jal Jeevan Mission. Monorepo: React (Vite) client + Node/Express API + plain PostgreSQL.",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w client && npm run build -w server",
    "start": "node server/dist/index.js",
    "provision": "npm run db:setup -w server && npm run db:migrate && npm run db:seed && npm run db:seed:demo",
    "db:setup": "npm run db:setup -w server",
    "db:migrate": "npm run migrate -w server",
    "db:gen:model": "npm run gen:model -w server",
    "db:seed": "npm run seed -w server",
    "db:seed:demo": "npm run seed:demo -w server",
    "db:reset": "npm run db:reset -w server",
    "test:isolation": "npm run test:isolation -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "zod": "^3.24.1"
  }
}
