modules = ["nodejs-20"]

# Workspace "Run" button: build the client + server, then start the single service.
run = "npm run build && npm run start"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm run start"]

# The Express server listens on PORT (default 3001) and also serves the built client.
[[ports]]
localPort = 3001
externalPort = 80

[env]
NODE_ENV = "production"
SESSION_COOKIE_SECURE = "true"
# TLS is decided by the connection string itself: a URL carrying sslmode=require (managed
# Postgres such as Neon) turns it on. Replit's in-container development database speaks no
# TLS (sslmode=disable), so PGSSL is deliberately NOT forced here — set the secret
# PGSSL=true only if you move to a managed database whose URL lacks sslmode=require.
