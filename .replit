modules = ["web", "nodejs-20", "postgresql-16"]

# Workspace "Run" button: build the client + server, provision reviewer accounts from
# protected seed values, then start the single service.
# --include=dev because the build needs tsc/vite (devDependencies) and NODE_ENV=production
# makes npm skip them.
run = "npm install --include=dev && npm run build && npm run db:seed && npm run start"

[deployment]
deploymentTarget = "autoscale"
# --include=dev is required: the build needs tsc and vite, which are devDependencies, and
# npm skips devDependencies when NODE_ENV=production (which this deployment sets).
# The built output is plain JS, so the runtime itself needs only the production deps.
build = ["sh", "-c", "npm install --include=dev && npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[env]
NODE_ENV = "production"
SESSION_COOKIE_SECURE = "true"
# TLS is decided by the connection string itself: a URL carrying sslmode=require (managed
# Postgres such as Neon) turns it on. Replit's in-container development database speaks no
# TLS (sslmode=disable), so PGSSL is deliberately NOT forced here — set the secret
# PGSSL=true only if you move to a managed database whose URL lacks sslmode=require.

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install --include=dev && npm run build && npm run db:seed && PORT=5000 npm run start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
