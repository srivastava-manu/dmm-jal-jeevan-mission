# ─────────────────────────────────────────────────────────────────────────────
# DMM configuration. Copy to `.env` and fill in. NOTHING here is committed.
# At NIC, every value below is supplied by the deployment environment.
# ─────────────────────────────────────────────────────────────────────────────

# Base database connection. Locally this IS the app (dmm_app) role. On a managed host
# (Replit/Neon) it is the provider-injected OWNER url — leave it and set APP_DATABASE_URL.
DATABASE_URL=postgresql://dmm_app:CHANGE_ME@localhost:5432/dmm_dev

# App (request-path) connection — the role the API connects as. OPTIONAL: when unset it
# falls back to DATABASE_URL (the local case). Set it on a managed host so the API uses the
# NON-owner, non-superuser, non-BYPASSRLS `dmm_app` role while DATABASE_URL (owner) drives
# migrations. RLS is only enforced against a non-owner role.
# APP_DATABASE_URL=postgresql://dmm_app:CHANGE_ME@HOST:5432/DB?sslmode=require

# Privileged connection used ONLY to run migrations and the dev seed (schema owner).
# If unset, falls back to DATABASE_URL.
ADMIN_DATABASE_URL=postgresql://arghyam@localhost:5432/dmm_dev

# Force TLS on the pg connections. Set true on managed Postgres (Replit/Neon require SSL);
# also auto-enabled when the URL contains sslmode=require. Leave false/unset locally.
# PGSSL=true

# Runtime. Set to "production" on NIC: enables secure cookies and terser logs.
NODE_ENV=development

# HTTP
PORT=3001

# Session cookie
SESSION_TTL_HOURS=168          # 7 days
SESSION_COOKIE_NAME=dmm_sid
SESSION_COOKIE_SECURE=false    # MUST be true in production (HTTPS). false only for local http dev.
SESSION_COOKIE_SAMESITE=lax

# Dev seed passwords (used only by `npm run db:seed`; never in production).
SEED_CENTRE_PASSWORD=CHANGE_ME
SEED_ASSESSOR_PASSWORD=CHANGE_ME

# ── Optional features (off unless set to "true") ──────────────────────────────
# Support requests: a state raising a request from a low-scored capability and the Centre
# answering it. Built and tested but out of scope for the current release, so it is disabled
# for BOTH roles. While off, /api/requests and /api/centre/requests return 404 — the feature
# is not merely hidden in the UI. The support_requests table and its RLS policies remain, so
# enabling it later is this variable and nothing else.
# FEATURE_SUPPORT_REQUESTS=true
